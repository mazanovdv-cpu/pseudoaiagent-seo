# Ключ доступа ProxyAPI. Не храните настоящий ключ в репозитории.
PROXYAPI_KEY=

# OpenAI-совместимый базовый адрес ProxyAPI, без пути конкретного метода.
PROXYAPI_BASE_URL=https://api.proxyapi.ru/v1

# Идентификатор модели в кабинете ProxyAPI.
# Платформа сама модель не выбирает: укажите ту, которая доступна вашему ключу.
PROXYAPI_MODEL=

# Токен источника Better Stack. Пустое значение оставляет логи только в stdout.
LOGTAIL_SOURCE_TOKEN=

# Хост приёма этого источника, со схемой https.
LOGTAIL_HOST=

# Пароль системного пользователя admin. Логин фиксированный: admin.
ADMIN_PASSWORD=

# Необязательный секрет подписи сессии. Если пусто, используется ADMIN_PASSWORD.
SESSION_SECRET=
